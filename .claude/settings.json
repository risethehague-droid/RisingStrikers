{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/tools/sync.sh --start; bash \"$CLAUDE_PROJECT_DIR\"/tools/agent.sh status",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
